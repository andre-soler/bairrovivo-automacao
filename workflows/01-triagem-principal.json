    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH atualiza AS (\n  UPDATE ocorrencias\n  SET status = 'nao_procedente'\n  WHERE id = $1\n)\nINSERT INTO automacao_log (ocorrencia_id, execucao_id, etapa, resultado, detalhe)\nVALUES ($1, $2, 'validar', 'invalida', $3::jsonb);",
        "options": {
          "queryReplacement": "={{ [ $json.id, $execution.id, JSON.stringify({ motivos: $json.motivos, entrada: $json.entrada }) ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "id": "db8885a8-2267-4a38-b2a6-1613faaa7e69",
      "name": "Registrar inválida",
      "position": [
        1520,
        220
