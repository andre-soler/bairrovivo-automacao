    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  $1::int AS ocorrencia_id,\n  d.id     AS dup_id,\n  d.titulo AS dup_titulo,\n  ROUND(d.distancia_m::numeric, 1)::float8 AS distancia_m\nFROM (SELECT 1) AS base\nLEFT JOIN LATERAL (\n  SELECT o.id, o.titulo,\n         6371000 * 2 * ASIN(SQRT(\n           POWER(SIN(RADIANS(o.latitude - $3::float8) / 2), 2) +\n           COS(RADIANS($3::float8)) * COS(RADIANS(o.latitude)) *\n           POWER(SIN(RADIANS(o.longitude - $4::float8) / 2), 2)\n         )) AS distancia_m\n  FROM ocorrencias o\n  WHERE o.id <> $1::int\n    AND o.categoria = $2\n    AND o.status NOT IN ('resolvida', 'nao_procedente')\n  ORDER BY distancia_m\n  LIMIT 1\n) AS d ON true;",
        "options": {
          "queryReplacement": "={{ [ $json.id, $json.categoria, $json.lat, $json.lng ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "id": "29b69fca-8a48-4b11-95f5-af4ce4c22feb",
      "name": "Buscar duplicata",
      "position": [
        1520,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "EfMzb9gFgmZMMPCA",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Junta o resultado da busca de duplicidade com os dados completos da ocorrencia\nconst validas = $('Validar').all();\n\nreturn $input.all().map((item) => {\n  const d = item.json;\n  const base = validas.find(v => v.json.id === d.ocorrencia_id).json;\n  const duplicata = d.dup_id != null && d.distancia_m <= base.cfg_raio_dup_m;\n\n  return {\n    json: {\n      ...base,\n      dup_id: d.dup_id ?? null,\n      dup_titulo: d.dup_titulo ?? null,\n      distancia_m: d.distancia_m ?? null,\n      duplicata,\n    },\n  };\n});"
      },
