    {
      "parameters": {
        "jsCode": "const categorias = ['buraco', 'iluminacao', 'descarte', 'calcada', 'mobiliario'];\n\nfor (const item of $input.all()) {\n  const o = item.json;\n  const motivos = [];\n\n  if (!o.titulo || o.titulo.trim().length < 5) {\n    motivos.push('titulo muito curto');\n  }\n  const cat = String(o.categoria ?? '').trim().toLowerCase();\n  if (!categorias.includes(cat)) {\n    motivos.push(`categoria invalida: \"${o.categoria}\"`);\n  }\n  if (typeof o.lat !== 'number' || o.lat < o.cfg_lat_min || o.lat > o.cfg_lat_max) {\n    motivos.push('latitude fora da area piloto');\n  }\n  if (typeof o.lng !== 'number' || o.lng < o.cfg_lng_min || o.lng > o.cfg_lng_max) {\n    motivos.push('longitude fora da area piloto');\n  }\n\n  item.json.valida = motivos.length === 0;\n  item.json.motivos = motivos;\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
