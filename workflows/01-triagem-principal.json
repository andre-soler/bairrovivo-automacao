    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH notificacao AS (\n  INSERT INTO automacao_notificacoes (ocorrencia_id, destinatario, canal, mensagem)\n  VALUES ($1, $2, 'email_mock', $3)\n)\nINSERT INTO automacao_log (ocorrencia_id, execucao_id, etapa, resultado, detalhe)\nVALUES ($1, $4, 'notificar', 'ok', $5::jsonb);",
        "options": {
          "queryReplacement": "={{ [ $json.id, $json.alias, `Olá, ${$json.alias}! Sua ocorrência #${$json.id} (\"${$json.titulo}\") foi recebida e está em análise pela equipe de zeladoria.` + ($json.precisa_revisao ? ' Ela passará por uma revisão manual antes do atendimento.' : ''), $execution.id, JSON.stringify({ canal: 'email_mock', destinatario: $json.alias }) ] }}"
        }
      },
