        "query": "SELECT o.id, o.titulo, o.descricao, o.categoria, o.status,\n       o.latitude, o.longitude, o.alias, o.criado_em\nFROM ocorrencias o\nWHERE o.status = 'recebida'\n  AND o.origem = 'cidadao'\n  AND NOT EXISTS (\n        SELECT 1 FROM automacao_log l\n        WHERE l.ocorrencia_id = o.id\n      )\nORDER BY o.id\nLIMIT 20;",
