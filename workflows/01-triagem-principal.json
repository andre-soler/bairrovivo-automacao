      "id": "7c0c6d49-5ece-4eda-aa2d-780f7b950e7d",
      "name": "Classificar (IA)",
      "position": [
        1968,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Junta a resposta da IA (real ou mock) com os dados da ocorrencia\nconst bases = $('Avaliar duplicidade').all();\nconst entradas = $input.all();\n\nreturn entradas.map((item, i) => {\n  const r = item.json;\n  let base = bases.find(b => b.json.id === r.id)?.json;\n  if (!base) base = $('Avaliar duplicidade').itemMatching(i).json;\n\n  const categoriaSugerida = r.categoria_sugerida ?? base.categoria;\n  const confianca = Number(r.confianca ?? 0);\n\n  const motivosRevisao = [];\n  if (confianca < 0.7) motivosRevisao.push('confianca baixa da IA');\n  if (categoriaSugerida !== base.categoria) motivosRevisao.push('IA sugeriu outra categoria');\n  if (base.duplicata) motivosRevisao.push('possivel duplicata da ocorrencia ' + base.dup_id);\n\n  return {\n    json: {\n      ...base,\n      categoria_sugerida: categoriaSugerida,\n      confianca,\n      modelo_ia: r.modelo ?? 'desconhecido',\n      justificativa_ia: r.justificativa ?? '',\n      precisa_revisao: motivosRevisao.length > 0,\n      motivos_revisao: motivosRevisao,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "02490db7-cd18-4013-bcf6-79581d954a91",
      "name": "Juntar classificação",
      "position": [
        2192,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH atualiza AS (\n  UPDATE ocorrencias\n  SET status = 'em_analise'\n  WHERE id = $1 AND status = 'recebida'\n)\nINSERT INTO automacao_log (ocorrencia_id, execucao_id, etapa, resultado, detalhe)\nVALUES ($1, $2, 'classificar', 'ok', $3::jsonb),\n       ($1, $2, 'encaminhar', $4, $5::jsonb);",
        "options": {
          "queryReplacement": "={{ [ $json.id, $execution.id, JSON.stringify({ categoria_sugerida: $json.categoria_sugerida, confianca: $json.confianca, modelo: $json.modelo_ia, justificativa: $json.justificativa_ia }), $json.precisa_revisao ? 'revisao' : 'ok', JSON.stringify({ fila: 'zeladoria-' + $json.categoria, status_novo: 'em_analise', precisa_revisao: $json.precisa_revisao, motivos_revisao: $json.motivos_revisao, duplicata: $json.duplicata, dup_id: $json.dup_id }) ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "id": "e6787531-39ef-4b03-b4ef-b01c9e0eac04",
      "name": "Encaminhar",
